
FROM node:22-alpine AS deps-all

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/api/package.json    ./packages/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/web/package.json    ./packages/web/

RUN npm ci


FROM node:22-alpine AS deps-prod

WORKDIR /app


COPY package.json ./
COPY packages/api/package.json    ./packages/api/
COPY packages/shared/package.json ./packages/shared/
RUN mkdir -p packages/web && printf '{"name":"web","version":"0.0.0","private":true}' > packages/web/package.json

RUN npm install --omit=dev --ignore-scripts && \
    npm prune --omit=dev && \
    rm -rf /app/node_modules/@prisma/engines && \
    find /app/node_modules -name "*.node" -delete 2>/dev/null || true && \
    find /app/node_modules -name "*.wasm" -delete 2>/dev/null || true


FROM node:22-alpine AS build

WORKDIR /app

COPY --from=deps-all /app/node_modules ./node_modules
COPY . .


RUN npx prisma generate --config packages/api/prisma.config.ts && \
    find packages/api/src/generated -name "*.node" -delete 2>/dev/null || true


RUN npx tsc -p tsconfig.prod.json

FROM node:22-alpine AS migrate

WORKDIR /app

COPY --from=deps-all /app/node_modules ./node_modules
COPY packages/api/prisma           ./packages/api/prisma
COPY packages/api/prisma.config.ts ./packages/api/prisma.config.ts
COPY packages/api/package.json     ./packages/api/
COPY packages/shared/package.json  ./packages/shared/

CMD ["node", "node_modules/.bin/prisma", "migrate", "deploy", "--config", "packages/api/prisma.config.ts"]


FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

RUN apk add --no-cache wget

COPY --chown=node:node --from=deps-prod /app/node_modules ./node_modules

COPY --chown=node:node --from=build /app/packages/api/src ./packages/api/src

COPY --chown=node:node --from=build /app/packages/shared ./packages/shared

COPY --chown=node:node packages/api/prisma           ./packages/api/prisma
COPY --chown=node:node packages/api/prisma.config.ts ./packages/api/prisma.config.ts

COPY --chown=node:node packages/api/package.json    ./packages/api/
COPY --chown=node:node packages/shared/package.json ./packages/shared/

USER node

EXPOSE 3000
EXPOSE 9464

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["node", "packages/api/src/app.js"]
